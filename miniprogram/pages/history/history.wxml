<view class="page">
  <view class="empty-state" wx:if="{{isEmpty}}">
    <text class="empty-icon">🕐</text>
    <text class="empty-text">还没有浏览记录</text>
    <text class="empty-hint">浏览景点详情时会自动记录</text>
    <button class="gold-btn go-btn" bindtap="goExplore">去看看景点</button>
  </view>

  <view class="list" wx:else>
    <view class="item" wx:for="{{history}}" wx:key="id" bindtap="goToSpot" data-id="{{item.id}}">
      <text class="item-icon">{{item.typeIcon || '📍'}}</text>
      <view class="item-info">
        <text class="item-name">{{item.name}}</text>
        <text class="item-time">{{item.timeStr}}</text>
      </view>
      <view class="item-del" catchtap="removeOne" data-index="{{index}}">✕</view>
    </view>

    <view class="footer-actions">
      <text class="clear-link" bindtap="clearAll">清空全部记录</text>
    </view>
  </view>
</view>
