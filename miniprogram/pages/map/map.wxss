.map-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

/* 搜索栏 */
.search-bar {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  z-index: 100;
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  border-radius: var(--radius-btn);
  padding: 0 24rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

.search-bar.focused .search-input-wrap {
  border-color: var(--gold);
}

.search-icon {
  font-size: var(--font-base);
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: var(--font-base);
  color: var(--text-body);
}

.clear-btn {
  color: var(--text-light);
  font-size: var(--font-base);
  padding: 8rpx;
}

.filter-btn {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.filter-btn.active {
  border: 2rpx solid var(--gold);
}

.filter-count {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  background: var(--gold);
  color: #fff;
  font-size: 18rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  padding: 0 6rpx;
}

/* 搜索结果 */
.search-results {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  z-index: 99;
  background: #fff;
  border-radius: var(--radius-card);
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
  max-height: 500rpx;
  overflow-y: auto;
}

.search-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  gap: 16rpx;
  border-bottom: 1rpx solid #f0ebe0;
}

.search-item:last-child {
  border-bottom: none;
}

.result-icon {
  font-size: 36rpx;
}

.result-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.result-name {
  font-size: var(--font-base);
  color: var(--text-title);
  font-weight: 600;
}

.result-addr {
  font-size: var(--font-xs);
  color: var(--text-sub);
}

.result-district {
  font-size: var(--font-xs);
  color: var(--text-light);
  background: var(--bg);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-tag);
}

/* 筛选面板 */
.filter-panel {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  z-index: 102;
  background: #fff;
  border-radius: var(--radius-card);
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.12);
  transform: translateY(-20rpx);
  opacity: 0;
  pointer-events: none;
  transition: all 0.25s ease;
}

.filter-panel.show {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.filter-title {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--text-title);
}

.filter-reset {
  font-size: var(--font-sm);
  color: var(--gold);
}

.filter-section {
  margin-bottom: 20rpx;
}

.filter-label {
  font-size: var(--font-sm);
  color: var(--text-sub);
  margin-bottom: 12rpx;
  display: block;
}

.filter-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-tag);
  font-size: var(--font-xs);
  color: var(--text-sub);
  background: #f5f3ef;
  border: 1rpx solid transparent;
  transition: all 0.2s;
}

.tag.active {
  color: var(--gold-dark);
  background: rgba(248, 227, 176, 0.4);
  border-color: var(--gold-light);
}

.filter-actions {
  margin-top: 8rpx;
  display: flex;
  justify-content: center;
}

.filter-mask {
  position: absolute;
  inset: 0;
  z-index: 101;
  background: rgba(0,0,0,0.3);
}

/* 地图 */
.main-map {
  width: 100%;
  height: 100%;
}

/* 图例 */
.legend-toggle {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 50;
  background: rgba(255,255,255,0.9);
  padding: 16rpx 12rpx;
  border-radius: var(--radius-card);
  font-size: var(--font-sm);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
  writing-mode: vertical-lr;
  letter-spacing: 4rpx;
}

.legend-panel {
  position: absolute;
  right: 24rpx;
  top: 35%;
  z-index: 102;
  background: #fff;
  border-radius: var(--radius-card);
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.12);
  min-width: 400rpx;
  display: none;
}

.legend-panel.show {
  display: block;
}

.legend-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.legend-title {
  font-size: var(--font-md);
  font-weight: 700;
}

.legend-close {
  font-size: var(--font-base);
  color: var(--text-light);
  padding: 8rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0ebe0;
}

.legend-item:last-child {
  border-bottom: none;
}

.legend-icon {
  font-size: 32rpx;
}

.legend-name {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--text-body);
}

/* 底部栏 */
.bottom-bar {
  position: absolute;
  bottom: calc(env(safe-area-inset-bottom) + 16rpx);
  left: 24rpx;
  right: 24rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(20rpx);
  border-radius: var(--radius-card);
  padding: 16rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.bottom-title {
  font-size: var(--font-sm);
  color: var(--text-title);
  font-weight: 600;
}

.bottom-count {
  font-size: var(--font-xs);
  color: var(--text-sub);
  margin-left: 8rpx;
}

.bottom-info {
  display: flex;
  flex-direction: column;
}

.bottom-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 20rpx;
  background: rgba(248, 227, 176, 0.4);
  border-radius: var(--radius-tag);
  font-size: var(--font-sm);
  color: var(--gold-dark);
  position: relative;
}

.badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  background: var(--gold);
  color: #fff;
  font-size: 18rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  border-radius: 14rpx;
  padding: 0 4rpx;
}

/* 行程面板 */
.itinerary-panel {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 102;
  background: #fff;
  border-top-left-radius: var(--radius-card);
  border-top-right-radius: var(--radius-card);
  padding: 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  max-height: 60vh;
  overflow-y: auto;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.itinerary-panel.show {
  transform: translateY(0);
}

.itinerary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.itinerary-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-title);
}

.itinerary-close {
  font-size: var(--font-base);
  color: var(--text-light);
  padding: 8rpx;
}

.itinerary-empty {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-light);
}

.itinerary-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0ebe0;
}

.itinerary-index {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: linear-gradient(135deg, var(--gold), var(--gold-dark));
  color: #fff;
  border-radius: 50%;
  font-size: var(--font-sm);
  font-weight: 700;
}

.itinerary-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.itinerary-name {
  font-size: var(--font-base);
  color: var(--text-title);
  font-weight: 600;
}

.itinerary-addr {
  font-size: var(--font-xs);
  color: var(--text-sub);
}

.itinerary-remove {
  color: var(--error);
  font-size: var(--font-base);
  padding: 8rpx;
}

.itinerary-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  justify-content: center;
}

.itinerary-mask {
  position: absolute;
  inset: 0;
  z-index: 101;
  background: rgba(0,0,0,0.3);
}
