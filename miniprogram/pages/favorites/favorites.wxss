.page {
  min-height: 100vh;
  background: var(--bg-page);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  gap: 20rpx;
}

.empty-icon { font-size: 80rpx; }

.empty-text {
  font-family: "KaiTi", "STKaiti", "FZXingKai-S04", serif;
  font-size: var(--font-lg);
  color: var(--text-title);
  font-weight: 700;
}

.empty-hint {
  font-size: var(--font-sm);
  color: var(--text-light);
  margin-bottom: 24rpx;
}

.go-btn {
  width: 360rpx;
}

/* List */
.list { padding-bottom: 60rpx; }

.item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  margin: 16rpx 24rpx;
  background: #fff;
  border-radius: var(--radius-card);
  gap: 16rpx;
}

.item-icon { font-size: 40rpx; }

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.item-name {
  font-family: "KaiTi", "STKaiti", "FZXingKai-S04", serif;
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--text-title);
}

.item-addr {
  font-size: var(--font-xs);
  color: var(--text-light);
}

.item-del {
  font-size: var(--font-base);
  color: var(--text-light);
  padding: 12rpx;
}

.footer-actions {
  text-align: center;
  padding: 40rpx;
}

.clear-link {
  font-size: var(--font-sm);
  color: var(--error);
}
