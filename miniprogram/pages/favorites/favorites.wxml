<view class="page">
  <view class="empty-state" wx:if="{{isEmpty}}">
    <text class="empty-icon">⭐</text>
    <text class="empty-text">还没有收藏任何景点</text>
    <text class="empty-hint">在景点详情页点击收藏按钮添加</text>
    <button class="gold-btn go-btn" bindtap="goExplore">去发现景点</button>
  </view>

  <view class="list" wx:else>
    <view class="item" wx:for="{{favorites}}" wx:key="id" bindtap="goToSpot" data-id="{{item.id}}">
      <text class="item-icon">{{item.typeIcon || '📍'}}</text>
      <view class="item-info">
        <text class="item-name">{{item.name}}</text>
        <text class="item-addr">{{item.districtName}} · {{item.address}}</text>
      </view>
      <view class="item-del" catchtap="removeFavorite" data-id="{{item.id}}">✕</view>
    </view>

    <view class="footer-actions">
      <text class="clear-link" bindtap="clearAll">清空全部收藏</text>
    </view>
  </view>
</view>
