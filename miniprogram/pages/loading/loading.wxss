.loading-page {
  width: 100vw;
  height: 100vh;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.loading-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg,
    rgba(0, 0, 0, 0.2) 0%,
    rgba(0, 0, 0, 0.05) 40%,
    rgba(0, 0, 0, 0.3) 75%,
    rgba(0, 0, 0, 0.55) 100%
  );
}

.loading-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
  padding-bottom: 120rpx;
  width: 100%;
}

.loading-title {
  font-family: "KaiTi", "STKaiti", "FZXingKai-S04", serif;
  font-size: 52rpx;
  font-weight: 700;
  color: #fefaf0;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.5);
  margin-bottom: 12rpx;
  letter-spacing: 8rpx;
}

.loading-subtitle {
  font-family: "FangSong", "STFangsong", serif;
  font-size: 26rpx;
  color: rgba(254, 250, 240, 0.85);
  text-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.4);
  margin-bottom: 60rpx;
  letter-spacing: 4rpx;
}

.progress-wrap {
  width: 480rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.progress-track {
  width: 100%;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #eac56b, #c49a2b, #b57c1c);
  border-radius: 4rpx;
  transition: width 0.4s ease;
  box-shadow: 0 0 12rpx rgba(196, 154, 43, 0.6);
}

.progress-text {
  font-family: "FangSong", "STFangsong", serif;
  font-size: 22rpx;
  color: rgba(254, 250, 240, 0.7);
  letter-spacing: 2rpx;
}
